{
  "name": "kodecol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start -p 3005",
    "lint": "eslint",
    "brand:assets": "node scripts/generate_brand_assets.mjs",
    "og:images": "node scripts/generate_og_images.mjs",
    "og:biblioteca": "node scripts/generate_library_og.mjs",
    "images:variants": "node scripts/generate_image_variants.mjs",
    "assets": "pnpm brand:assets && pnpm og:images && pnpm og:biblioteca && pnpm images:variants",
    "deploy:build": "next build && node scripts/build_htaccess.mjs",
    "serve:out": "node scripts/serve_out.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
